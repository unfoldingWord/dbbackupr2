# DB Connection parameters
DB_HOST=db_host.example.com
DB_USER=db_user
DB_PASSWORD=db_password
# Only backup these DBs. Opposite of DB_EXCLUDED
#DBS=my_test_db,my_test_db2
# Do not backup these DB's. Opposite of DBS
DBS_EXCLUDED=information_schema,mysql,performance_schema,sys
# Where to backup to
BACKUP_DIR=/dbbackup
# Prefix for backup files
BACKUP_PREFIX=mysql
# mysqldump/mariadb-dump options
#BACKUP_OPTS=--dump-history
# How many days to keep backups
MYSQL_KEEP_DAYS=30
# Compress the backup (with bzip2)
COMPRESS_BACKUP=true
DEBUG=false
